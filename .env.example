# ============================================================
# Solvix Backend — Variables de Entorno
# ============================================================
# Copia este archivo a .env y completa los valores:
#   cp .env.example .env
# ============================================================

# ── Servidor ────────────────────────────────────────────────
PORT=3000

# ── Base de Datos PostgreSQL ────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=solvix

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=changeme_to_a_long_random_secret_in_production
